# TripMind environment configuration.
# Copy to `.env` and fill in values. `.env` is git-ignored; never commit real secrets.

# ── Runtime ───────────────────────────────────────────────────────────────
ENVIRONMENT=local                # local | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=true

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=tripmind
POSTGRES_PASSWORD=tripmind
POSTGRES_DB=tripmind
# Used when running the API outside Docker. Inside Compose it is overridden to host `db`.
DATABASE_URL=postgresql+psycopg://tripmind:tripmind@127.0.0.1:5432/tripmind

# ── Authentication ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-insecure-secret-change-me-before-any-deployment
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false              # true when served over HTTPS
TRUST_PROXY_HEADERS=true         # trust X-Forwarded-For from the Next.js proxy

# Demo accounts created by `python -m app.cli seed`
DEMO_TRAVELER_EMAIL=demo@tripmind.dev
DEMO_ADMIN_EMAIL=admin@tripmind.dev

# ── Feature flag overrides (defaults live in config/features.yaml) ────────
# FEATURE_DEMO_LOGIN=true

# ── Frontend ──────────────────────────────────────────────────────────────
# Where the Next.js server proxies /api/* (inside Compose: http://api:8000)
API_INTERNAL_URL=http://localhost:8000
