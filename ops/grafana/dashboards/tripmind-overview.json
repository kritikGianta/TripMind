          },
          "expr": "sum by (entity, outcome) (increase(import_rows_total[$__range]))",
          "legendFormat": "{{entity}} {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Sign-in events",
      "description": "Per minute. A spike in login failures suggests password guessing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (event, outcome) (rate(auth_events_total[5m])) * 60",
          "legendFormat": "{{event}} {{outcome}}",
          "refId": "A"
        }
      ]
    }
  ]
}
